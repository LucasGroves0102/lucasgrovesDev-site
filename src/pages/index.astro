---
import Base from "../layouts/Base.astro";

const posts = Object.values(
  import.meta.glob("./writing/*.md", { eager: true }),
)
  .map((post: any) => ({
    url: post.url,
    title: post.frontmatter.title,
    date: post.frontmatter.date,
  }))
  .sort((a, b) => new Date(b.date).valueOf() - new Date(a.date).valueOf());

const repo = "https://github.com/LucasGroves0102/tributary";

const facts = [
  {
    text: "Every new SEC filing in the database 45 seconds after EDGAR accepts it at the median, 1.6 minutes at p95",
    proof: `${repo}#readme`,
  },
  {
    text: "128 of 128 figures in the AI assistant's answers traced back to a filing or XBRL fact",
    proof: `${repo}/blob/main/tests/citations/report.md`,
  },
  {
    text: "Revoked access gone from every derived table in under 0.2 seconds, checked on every CI run",
    proof: `${repo}/blob/main/tests/propagation/report.md`,
  },
  {
    text: "Filing parser rewritten in Rust: 8.8x faster, zero output differences on 57,000 fuzzed documents",
    proof: `${repo}/blob/main/benchmarks/README.md`,
  },
];

const fmt = (d: string) =>
  new Date(d).toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
    timeZone: "UTC",
  });
---

<Base title="Lucas Groves, data engineer" current="home">
  <h1>I build data platforms that people can trust with their numbers.</h1>
  <p class="lede">
    I'm a data engineer in Phoenix. I work on streaming pipelines, Postgres, and Databricks, and
    I care about the unglamorous parts: data that's correct, provenance on every row, and systems
    that recover on their own.
  </p>

  <h2>Tributary</h2>
  <p>
    <a href="https://tributary.lucasgroves.dev">Tributary</a> is a research platform for SEC filings
    that I built and run on my own server. It streams every new filing from EDGAR into a
    bronze, silver and gold Postgres model, standardizes financials for 6,000+ companies, and gives
    analysts a workflow from filings to a checked investment thesis. Its AI assistant answers only
    from data you're allowed to see, and every figure it states is verified against the source.
  </p>
  <ul class="facts">
    {facts.map((f) => (
      <li>
        <span>{f.text}</span>
        <a class="proof" href={f.proof}>See the evidence</a>
      </li>
    ))}
  </ul>
  <p>
    <a href="https://tributary.lucasgroves.dev">Try the live demo</a>, or
    <a href={repo}>read the code</a>.
  </p>

  <h2>Work</h2>
  <div class="role">
    <h3>Data Engineer II, Sprouts Farmers Market</h3>
    <p class="quiet">June 2026 to present</p>
    <p>Campaign measurement and decisioning pipelines on Azure Databricks.</p>
  </div>
  <div class="role">
    <h3>Software Engineer, Wise Pelican</h3>
    <p class="quiet">December 2025 to June 2026</p>
    <p>
      Proposed and led a move from cloud to on-prem that cut infrastructure spend about 64%, built
      the cluster, consolidated data on ~140M U.S. properties into one Postgres database, and
      replaced 10-hour refreshes with a 25-minute incremental pipeline.
    </p>
  </div>
  <div class="role">
    <h3>Software Engineer Intern, Western Semiconductor</h3>
    <p class="quiet">April to September 2024</p>
    <p>C++ and Python work on an early-stage chip design toolchain.</p>
  </div>
  <p class="quiet">B.S. in Mathematics, Arizona State University, 2025.</p>

  <h2>Writing</h2>
  <ul class="posts">
    {posts.map((p) => (
      <li>
        <a href={p.url}>{p.title}</a>
        <span class="date">{fmt(p.date)}</span>
      </li>
    ))}
  </ul>
</Base>
