---
import Base from "./Base.astro";

const { frontmatter } = Astro.props;

const date = new Date(frontmatter.date).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});
---

<Base title={`${frontmatter.title} | Lucas Groves`} description={frontmatter.summary} current="writing">
  <div class="post-page">
    <div class="container">
      <article>
        <h1>{frontmatter.title}</h1>
        <p class="meta">{date}</p>
        <slot />
      </article>
      <a class="back" href="/writing/">All writing</a>
    </div>
  </div>
</Base>
