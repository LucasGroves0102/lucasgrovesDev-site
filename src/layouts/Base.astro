---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  current?: "home" | "writing";
}

const {
  title,
  description = "Lucas Groves, data engineer. Streaming pipelines, Postgres and Databricks, and Tributary, a research platform for SEC filings.",
  current,
} = Astro.props;

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#222930" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=Literata:opsz,wght@7..72,400;7..72,500;7..72,600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="topbar">
      <div class="container">
        <a class="brand" href="/">
          <span class="mark" aria-hidden="true"><span></span><span></span><span></span></span>
          Lucas Groves
        </a>
        <nav class="nav" aria-label="Main">
          <a class="hide-sm" href="/#tributary">Tributary</a>
          <a class="hide-sm" href="/#experience">Experience</a>
          <a href="/writing/" aria-current={current === "writing" ? "page" : undefined}>Writing</a>
          <a class="btn-small" href="/#contact">Contact</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">Lucas Groves, {year}. Built with Astro.</div>
    </footer>
  </body>
</html>
